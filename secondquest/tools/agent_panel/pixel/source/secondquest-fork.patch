+    outDir: path.resolve(__dirname, '../../dist/sq'),
+    emptyOutDir: true,
+    assetsDir: '.',
+    cssCodeSplit: false,
+    modulePreload: false,
+    rollupOptions: {
+      output: {
+        entryFileNames: 'pixel-office.js',
+        chunkFileNames: 'pixel-office-[name].js',
+        assetFileNames: 'pixel-office[extname]',
+      },
+    },
+  },
+});
