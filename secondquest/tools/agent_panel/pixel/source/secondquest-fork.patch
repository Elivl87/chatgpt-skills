diff --git a/webview-ui/src/sq/sqTransport.ts b/webview-ui/src/sq/sqTransport.ts
new file mode 100644
index 0000000..e8a2c25
--- /dev/null
+++ b/webview-ui/src/sq/sqTransport.ts
@@ -0,0 +1,275 @@
+/**
+ * SecondQuest adapter: a serverless MessageTransport for the Pixel Agents webview.
+ *
+ * Instead of a VS Code extension or the standalone WebSocket server, this
+ * transport (1) replays the asset handshake from a pre-decoded static JSON file
+ * (office-data.json, produced at build time from the bundled PNGs) and
+ * (2) subscribes to the claude.ai Artifact db (`agents` collection) and turns
+ * each doc's status into the same ServerMessages the extension would emit.
+ *
+ *   working -> agentToolStart(task) + agentStatus active   (walks to desk, types/reads)
+ *   waiting -> agentToolsClear + agentStatus waiting(awaitingInput)  ("Esperando" label)
+ *   stuck   -> agentToolStart(permissionActive) + agentToolPermission (amber "..." bubble)
+ *   done    -> agentToolsClear + agentStatus waiting (green check bubble), then idle/wander
+ *   doc removed -> agentClosed (despawn effect)
+ */
+import { TRANSPORT_STATE_CONNECTED } from '../../../core/src/constants.js';
+import type { ClientMessage, ServerMessage } from '../../../core/src/messages.js';
+import type { MessageTransport, TransportState } from '../transport/types.js';
+
+export interface SqAgentDoc {
+  id: string;
+  name?: string;
+  short?: string;
+  role?: string;
+  task?: string;
+  status?: string;
+  progress?: number;
+  order?: number;
+  updated?: unknown;
+}
+
+interface OfficeData {
+  characters: unknown[];
+  pets: unknown[];
+  petNames: string[];
+  floorSprites: unknown;
+  wallSets: unknown;
+  carpetSets: unknown;
+  furnitureCatalog: unknown;
+  furnitureSprites: unknown;
+  layout: unknown;
+}
+
+interface DbLike {
+  collection(name: string): {
+    onSnapshot(cb: (snap: { docs: Array<{ id: string; data(): Record<string, unknown> }> }) => void): unknown;
+  };
+}
+
+interface Tracked {
+  num: number;
+  status: string;
+  task: string;
+  label: string;
+  role: string;
+  toolSeq: number;
+  toolId: string | null;
+}
+
+type Handler = (m: ServerMessage) => void;
+
+const READING_HINT = /investig|lee|leer|leyendo|revis|busca|research|read|review|analiz|audit|verific|estudi|consult/i;
+
+declare global {
+  interface Window {
+    claude?: { use(name: string): Promise<unknown> | unknown };
+    __SQ_DB__?: Promise<unknown>;
+    __SQ_FAKE_AGENTS__?: SqAgentDoc[];
+    __sqPixel?: { feed(docs: SqAgentDoc[]): void; officeData?: string };
+  }
+}
+
+export class SqTransport implements MessageTransport {
+  readonly state: TransportState = TRANSPORT_STATE_CONNECTED;
+  readonly ready: Promise<void> = Promise.resolve();
+  private handlers = new Set<Handler>();
+  private started = false;
+  private layoutSent = false;
+  private pendingDocs: SqAgentDoc[] | null = null;
+  private tracked = new Map<string, Tracked>();
+  private nextNum = 1;
+
+  send(message: ClientMessage): void {
+    // All client->server messages (seat saves, layout saves, settings) are
+    // ignored: the db is the only source of truth. webviewReady kicks off the replay.
+    if ((message as { type: string }).type === 'webviewReady' && !this.started) {
+      this.started = true;
+      void this.start();
+    }
+  }
+
+  onMessage(handler: Handler): () => void {
+    this.handlers.add(handler);
+    return () => this.handlers.delete(handler);
+  }
+
+  onStateChange(): () => void {
+    return () => {};
+  }
+
+  dispose(): void {
+    this.handlers.clear();
+  }
+
+  private emit(msg: Record<string, unknown>): void {
+    for (const h of this.handlers) {
+      try {
+        h(msg as unknown as ServerMessage);
+      } catch (err) {
+        console.error('[sq] handler error', msg.type, err);
+      }
+    }
+  }
+
+  private async start(): Promise<void> {
+    const url = window.__sqPixel?.officeData ?? 'office-data.json';
+    const data = (await fetch(url).then((r) => r.json())) as OfficeData;
+    this.emit({
+      type: 'providerCapabilities',
+      readingTools: ['Read', 'Grep', 'Glob', 'WebFetch', 'WebSearch'],
+      subagentToolNames: ['Task', 'Agent'],
+    });
+    this.emit({ type: 'characterSpritesLoaded', characters: data.characters });
+    this.emit({ type: 'petSpritesLoaded', pets: data.pets, petNames: data.petNames });
+    this.emit({ type: 'floorTilesLoaded', sprites: data.floorSprites });
+    this.emit({ type: 'wallTilesLoaded', sets: data.wallSets });
+    this.emit({ type: 'carpetTilesLoaded', sets: data.carpetSets });
+    this.emit({
+      type: 'furnitureAssetsLoaded',
+      catalog: data.furnitureCatalog,
+      sprites: data.furnitureSprites,
+    });
+    this.emit({
+      type: 'settingsLoaded',
+      soundEnabled: false,
+      lastSeenVersion: '',
+      extensionVersion: '',
+      watchAllSessions: false,
+      alwaysShowLabels: true,
+      ghostHeadlessAgents: false,
+      hooksEnabled: false,
+      hooksInfoShown: true,
+      externalAssetDirectories: [],
+      showAreas: false,
+    });
+    this.emit({ type: 'areaMappingsLoaded', mappings: {} });
+    this.emit({ type: 'layoutLoaded', layout: data.layout });
+    this.layoutSent = true;
+
+    // Expose a manual feed (used by tests / by the host page if it prefers to own the db).
+    window.__sqPixel = { ...(window.__sqPixel ?? {}), feed: (docs) => this.apply(docs) };
+    if (this.pendingDocs) this.apply(this.pendingDocs);
+    void this.subscribe();
+  }
+
+  private async subscribe(): Promise<void> {
+    try {
+      let dbP: unknown = window.__SQ_DB__;
+      if (!dbP && window.claude?.use) dbP = window.claude.use('db');
+      if (!dbP) {
+        if (window.__SQ_FAKE_AGENTS__) this.apply(window.__SQ_FAKE_AGENTS__);
+        return;
+      }
+      const db = (await dbP) as DbLike;
+      db.collection('agents').onSnapshot((snap) => {
+        this.apply(
+          snap.docs
+            .filter((d) => (d as { exists?: boolean }).exists !== false)
+            .map((d) => ({ id: d.id, ...d.data() }) as SqAgentDoc),
+        );
+      });
+    } catch (err) {
+      console.error('[sq] db subscribe failed', err);
+    }
+  }
+
+  /** Reconcile the full set of agent docs against the characters on screen. */
+  apply(docs: SqAgentDoc[]): void {
+    if (!this.layoutSent) {
+      this.pendingDocs = docs;
+      return;
+    }
+    const sorted = [...docs].sort(
+      (a, b) => (a.order ?? 999) - (b.order ?? 999) || String(a.id).localeCompare(String(b.id)),
+    );
+    const seen = new Set<string>();
+    for (const doc of sorted) {
+      if (!doc || !doc.id) continue;
+      seen.add(doc.id);
+      const label = String(doc.short || doc.name || doc.id);
+      const role = String(doc.role ?? '');
+      const task = String(doc.task ?? '').trim();
+      const status = normStatus(doc.status);
+      let t = this.tracked.get(doc.id);
+      if (!t) {
+        t = { num: this.nextNum++, status: '', task: '', label, role, toolSeq: 0, toolId: null };
+        this.tracked.set(doc.id, t);
+        this.emit({ type: 'agentCreated', id: t.num });
+        this.emit({ type: 'agentTeamInfo', id: t.num, agentName: label });
+      } else if (t.label !== label) {
+        t.label = label;
+        this.emit({ type: 'agentTeamInfo', id: t.num, agentName: label });
+      }
+      if (t.status !== status || t.task !== task) this.transition(t, status, task);
+    }
+    for (const [docId, t] of [...this.tracked]) {
+      if (seen.has(docId)) continue;
+      this.tracked.delete(docId);
+      this.emit({ type: 'agentClosed', id: t.num });
+    }
+  }
+
+  private startTool(t: Tracked, task: string, permission: boolean): void {
+    if (t.toolId) this.emit({ type: 'agentToolDone', id: t.num, toolId: t.toolId });
+    t.toolSeq += 1;
+    t.toolId = `sq-${t.num}-${t.toolSeq}`;
+    const reading = READING_HINT.test(task);
+    this.emit({
+      type: 'agentToolStart',
+      id: t.num,
+      toolId: t.toolId,
+      status: task || (reading ? 'Leyendo…' : 'Trabajando…'),
+      toolName: reading ? 'Read' : 'Write',
+      permissionActive: permission,
+    });
+  }
+
+  private clearTools(t: Tracked): void {
+    if (t.toolId) this.emit({ type: 'agentToolDone', id: t.num, toolId: t.toolId });
+    t.toolId = null;
+    this.emit({ type: 'agentToolsClear', id: t.num });
+  }
+
+  private transition(t: Tracked, status: string, task: string): void {
+    const prev = t.status;
+    t.status = status;
+    t.task = task;
+    switch (status) {
+      case 'working':
+        if (prev === 'stuck') this.emit({ type: 'agentToolPermissionClear', id: t.num });
+        this.startTool(t, task, false);
+        this.emit({ type: 'agentStatus', id: t.num, status: 'active' });
+        break;
+      case 'stuck':
+        this.startTool(t, task, true);
+        this.emit({ type: 'agentStatus', id: t.num, status: 'active' });
+        this.emit({ type: 'agentToolPermission', id: t.num });
+        break;
+      case 'waiting':
+        if (prev === 'stuck') this.emit({ type: 'agentToolPermissionClear', id: t.num });
+        this.clearTools(t);
+        this.emit({ type: 'agentStatus', id: t.num, status: 'waiting', awaitingInput: true });
+        break;
+      case 'done':
+      default:
+        if (prev === 'stuck') this.emit({ type: 'agentToolPermissionClear', id: t.num });
+        this.clearTools(t);
+        // Only celebrate a real finish; an agent that loads already-done just idles.
+        if (prev && prev !== 'done') {
+          this.emit({ type: 'agentStatus', id: t.num, status: 'waiting', awaitingInput: false });
+        } else {
+          this.emit({ type: 'agentStatus', id: t.num, status: 'idle' });
+        }
+        break;
+    }
+  }
+}
+
+function normStatus(s: unknown): string {
+  const v = String(s ?? '').toLowerCase();
+  if (v === 'working' || v === 'active' || v === 'running') return 'working';
+  if (v === 'waiting' || v === 'blocked' || v === 'pending') return 'waiting';
+  if (v === 'stuck' || v === 'error' || v === 'failed') return 'stuck';
+  return 'done';
+}
