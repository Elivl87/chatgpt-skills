new file mode 100644
index 0000000..9f643fb
--- /dev/null
+++ b/webview-ui/sqtools/decode-assets.ts
@@ -0,0 +1,60 @@
+// SecondQuest: pre-decode all bundled Pixel Agents assets into one JSON payload
+// (same data the standalone server sends over WebSocket on webviewReady).
+import * as fs from 'fs';
+import * as path from 'path';
+
+import { buildFurnitureCatalog } from '../../core/src/assets/build.ts';
+import {
+  decodeAllCarpets,
+  decodeAllCharacters,
+  decodeAllFloors,
+  decodeAllFurniture,
+  decodeAllWalls,
+} from '../../core/src/assets/loader.ts';
+import { decodePetPng } from '../../core/src/assets/pngDecoder.ts';
+
+const assetsDir = path.resolve(process.argv[2]);
+const out = path.resolve(process.argv[3]);
+
+const catalog = buildFurnitureCatalog(assetsDir);
+const petsDir = path.join(assetsDir, 'pets');
+const pets: unknown[] = [];
+const petNames: string[] = [];
+for (const dir of fs.readdirSync(petsDir).sort()) {
+  const m = JSON.parse(fs.readFileSync(path.join(petsDir, dir, 'manifest.json'), 'utf8'));
+  pets.push(decodePetPng(fs.readFileSync(path.join(petsDir, dir, 'pet.png'))));
+  petNames.push(m.name);
+}
+const layout = JSON.parse(fs.readFileSync(path.join(assetsDir, 'default-layout-1.json'), 'utf8'));
+layout.pets = petNames.map((_, i) => ({ id: `pet-${i}`, petType: i }));
+// Crop the empty (VOID) margin of the default layout so the office centers in the viewport:
+// keep one row above the first wall row (wall-mounted furniture sits there) and drop the
+// trailing void row/col. Furniture rows/cols shift by the same amount.
+{
+  const TOP = 8, KEEP_ROWS = 13, KEEP_COLS = 20;
+  const cols = layout.cols as number;
+  const crop = (arr: unknown[]) => {
+    const out: unknown[] = [];
+    for (let r = TOP; r < TOP + KEEP_ROWS; r++) out.push(...arr.slice(r * cols, r * cols + KEEP_COLS));
+    return out;
+  };
+  layout.tiles = crop(layout.tiles);
+  if (Array.isArray(layout.tileColors)) layout.tileColors = crop(layout.tileColors);
+  for (const f of layout.furniture) f.row -= TOP;
+  layout.rows = KEEP_ROWS;
+  layout.cols = KEEP_COLS;
+}
+
+const payload = {
+  characters: decodeAllCharacters(assetsDir),
+  pets,
+  petNames,
+  floorSprites: decodeAllFloors(assetsDir),
+  wallSets: decodeAllWalls(assetsDir),
+  carpetSets: decodeAllCarpets(assetsDir),
+  furnitureCatalog: catalog,
+  furnitureSprites: decodeAllFurniture(assetsDir, catalog),
+  layout,
+};
+fs.writeFileSync(out, JSON.stringify(payload));
+console.log('wrote', out, fs.statSync(out).size, 'bytes');
